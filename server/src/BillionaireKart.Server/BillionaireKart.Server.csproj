<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BillionaireKart.Server</AssemblyName>
    <RootNamespace>BillionaireKart.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- the handle titles are game content; the admin shows players by the same words -->
    <EmbeddedResource Include="../../../src/content/handles.js" LogicalName="handles.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BillionaireKart.Tests" />
  </ItemGroup>

</Project>
